{
  "name": "jamei-woukouf",
  "private": true,
  "description": "جامع الوقوف — الواجهة البرمجية والويب والجوال فوق قاعدة Postgres",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:app": "node apps/api/scripts/apply-sql.mjs db/app_schema.sql",
    "db:check": "node apps/api/scripts/db-check.mjs",
    "db:create": "node apps/api/scripts/db-create.mjs",
    "api": "npm run start:dev -w @jamei/api",
    "build": "npm run build -w @jamei/api && npm run build -w @jamei/web",
    "mobile": "npm run start -w @jamei/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "web": "npm run dev -w @jamei/web"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "react-native-web": "^0.21.2"
  }
}
