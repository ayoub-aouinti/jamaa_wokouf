# انسخ هذا الملف إلى apps/api/.env واملأه. وملفُّ .env لا يُحفَظ في git.

# القاعدةُ التي نُقلت إليها الأحكام بـ db/migrate.py
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jamei

PORT=3000
HOST=0.0.0.0

# أصولُ الويب المسموح لها خارجَ الجهاز، مفصولةٌ بفواصل. localhost مسموحٌ دائماً
# بأيِّ منفذ. «*» يفتح الكلَّ، وهو للتطوير مع الهاتف وحده.
CORS_ORIGINS=

# رموزُ المراجِعين بصيغة اسم:رمز مفصولةً بفواصل. يُقيَّد الاسمُ في review_log.
# فإن تُرك فارغاً أُغلقت الكتابةُ كلُّها (الاعتمادُ والردُّ وضبطُ المصطلحات).
ADMIN_TOKENS=
